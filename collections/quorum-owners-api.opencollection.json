{
  "opencollection": "1.0.0",
  "info": {
    "name": "Quorum Land Management DivisionOrders Owners API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://auth.quorumsoftware.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Owners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List mineral interest owners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.quorumsoftware.com/v1/owners",
            "params": [
              {
                "name": "ownerType",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns mineral interest owners with contact and payment information."
        }
      ]
    }
  ],
  "bundled": true
}